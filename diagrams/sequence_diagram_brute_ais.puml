@startuml
title Sekvenčný diagram: Modul na brute-forcovanie UKF AiS

participant "ikmu.sh\n(main)" as IKMU
participant "brute-ais.py\n(module)" as brute_module
participant "modules/passwords.txt\n(wordlist)" as Wordlist
participant "https://ais2.ukf.sk/ais/login.do\n(HTTP cieľ)" as AIS
participant "modules/logs/log_found_ais.txt\n(log súbor)" as LogFile
participant "Discord webhook\n(Discord server)" as Discord
participant "stdout" as Console

IKMU -> brute_module : spustenie nástroja a výber modulu

brute_module -> Wordlist : otvor a načítaj wordlist
alt wordlist nenájdený
  Wordlist --> brute_module : exception
  brute_module -> Console : vypíše chybu (FileNotFoundError) a ukončí
  brute_module --> IKMU : návrat s chybou
end

loop
    brute_module -> AIS : POST /ais/login.do (data, headers, cookies)
    AIS --> brute_module : HTTP response (status_code, headers, cookies)
  
    alt úspech (status_code == 302 AND location.startswith ("/ais/apps/student/sk"))
      brute_module -> Console : vypíše FOUND, meno, heslo a JSESSIONID
      brute_module -> LogFile : vytvorí a zapíše údaje do logovacieho súboru 
      alt Discord chyba
        Discord --> brute_module : exception
        brute_module -> Console : vypíše chybu pri odoslaní údajov na Discord
      end
      brute_module -> Discord : odošle údaje na Discord server
      brute_module --> IKMU : Ukonči program
     end
    alt neúspech
     brute_module -> Console : vypíše FAIL, skúšané heslo a status kód
    end
      brute_module -> brute_module : opakovanie po pauze: time.sleep(random.uniform(300, 350))
end

brute_module -> Console : heslo sa nenašlo
@enduml
